# Salin file ini jadi ".env" lalu sesuaikan.
# (.env tidak ikut di-commit — lihat .gitignore)

# Development: SQLite (satu file, otomatis dibuat)
DATABASE_URL=sqlite:///./pyquest.db

# Produksi nanti (Fase 9), ganti ke PostgreSQL, contoh:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/pyquest

# Kunci rahasia untuk token login (Fase 2). Ganti dengan string acak panjang.
SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang
